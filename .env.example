# Primer promenljivih okruženja. NE upisuj prave ključeve u ovaj fajl.
# Prave vrednosti se unose u Netlify: Project configuration → Environment variables.
# Uputstvo: docs/04-forms-newsletter-booking.md

# Adresa sajta (samo ako nije na Netlify-ju; Netlify je popunjava sam)
# SITE_URL=https://tvojdomen.rs

# --- Brevo (automatska potvrda prijema upita + newsletter) ---
BREVO_API_KEY=
# E-mail adresa sa koje se šalju potvrde (mora biti potvrđena u Brevo nalogu)
MEJL_POSILJAOCA=
IME_POSILJAOCA=Milica Uzelac
# ID liste za newsletter u Brevo-u (broj)
BREVO_LISTA_ID=
# ID šablona za potvrdu prijave (double opt-in); ako je prazno, kontakt se dodaje bez potvrde
BREVO_DOI_SABLON_ID=
