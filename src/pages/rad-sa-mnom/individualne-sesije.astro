---
import Osnovni from '../../layouts/Osnovni.astro';
import UvodStranice from '../../components/UvodStranice.astro';
import Fotografija from '../../components/Fotografija.astro';
import Ikona from '../../components/Ikona.astro';
import Pitanja from '../../components/Pitanja.astro';
import { sajt, mdRed, apsolutni } from '../../lib/sajt';
import s from '../../content/stranice/individualne-sesije.json';

const shema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Individualne coaching sesije',
  serviceType: 'Life coaching',
  description: s.seo.opis,
  provider: { '@type': 'Person', name: sajt.naziv, url: apsolutni('/', Astro.site) },
  areaServed: 'RS',
  url: apsolutni('/rad-sa-mnom/individualne-sesije/', Astro.site),
};
---

<Osnovni naslov={s.seo.naslov} opis={s.seo.opis} slika={s.za_koga.slika} shema={shema}>
  <UvodStranice
    nadnaslov={s.uvod.nadnaslov}
    naslov={s.uvod.naslov}
    uvod={s.uvod.tekst}
    putanja={[{ naziv: 'Rad sa mnom', link: '/rad-sa-mnom/' }, { naziv: 'Individualne sesije' }]}
  >
    <a href={sajt.zakazivanje.link} class="dugme" data-prati="booking_click" data-mesto="individualne-vrh">
      {sajt.zakazivanje.tekst_dugmeta}
      <Ikona naziv="strelica" />
    </a>
  </UvodStranice>

  <section class="sekcija sekcija--papir" aria-labelledby="za-koga-naslov">
    <div class="omot dvodelno dvodelno--slika-uza">
      <div data-otkrij>
        <Fotografija slika={s.za_koga.slika} alt={s.za_koga.slika_alt} oblik="luk" odnos="4/5" sablon={4} />
      </div>
      <div class="stog" data-otkrij style="--kasnjenje:1">
        <span class="nadnaslov">{s.za_koga.nadnaslov}</span>
        <h2 id="za-koga-naslov" set:html={mdRed(s.za_koga.naslov)} />
        <ul class="kvacice">
          {s.za_koga.stavke.map((stavka) => <li>{stavka}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="sekcija" aria-labelledby="kako-naslov">
    <div class="omot">
      <div class="glava-sekcije" data-otkrij>
        <span class="nadnaslov">{s.kako.nadnaslov}</span>
        <h2 id="kako-naslov" set:html={mdRed(s.kako.naslov)} />
      </div>
      <ol class="tok">
        {
          s.kako.koraci.map((korak, i) => (
            <li data-otkrij style={`--kasnjenje:${i}`}>
              <span class="tok__broj" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3>{korak.naslov}</h3>
                <p>{korak.tekst}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="detalji" data-otkrij>
        <h2 class="detalji__naslov">{s.detalji.naslov}</h2>
        <dl class="detalji__lista">
          {
            s.detalji.stavke.map((d) => (
              <div>
                <dt>
                  <Ikona naziv={d.ikona as any} velicina={20} />
                  {d.naziv}
                </dt>
                <dd>{d.vrednost}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="sekcija sekcija--bez-tamna" aria-labelledby="pitanja-naslov">
    <div class="omot pitanja-mreza">
      <div class="stog stog--mali" data-otkrij>
        <span class="nadnaslov">{s.pitanja.nadnaslov}</span>
        <h2 id="pitanja-naslov" set:html={mdRed(s.pitanja.naslov)} />
      </div>
      <div data-otkrij style="--kasnjenje:1">
        <Pitanja pitanja={s.pitanja.stavke} />
      </div>
    </div>
  </section>
</Osnovni>

<style>
  .tok {
    display: grid;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 52rem;
  }
  .tok li {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.25rem, 0.8rem + 2vw, 2.5rem);
    padding-bottom: 2.25rem;
  }
  .tok li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 1.6rem;
    top: 3.5rem;
    bottom: 0.25rem;
    width: 1px;
    background: var(--c-kajsija-tamna);
    opacity: 0.6;
  }
  .tok__broj {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--c-kajsija);
    font-family: var(--font-naslov);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1;
  }
  .tok h3 {
    margin-bottom: 0.4rem;
    padding-top: 0.45rem;
  }
  .tok p {
    color: var(--c-teget-blagi);
  }
  .detalji {
    margin-top: var(--r-4);
    padding: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
    border-radius: var(--z-veliki);
    background: var(--c-svetloplava-blaga);
  }
  .detalji__naslov {
    font-size: var(--fs-h3);
    margin-bottom: 1.5rem;
  }
  .detalji__lista {
    display: grid;
    gap: 1.5rem 2rem;
    margin: 0;
  }
  @media (min-width: 40em) {
    .detalji__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64em) {
    .detalji__lista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .detalji__lista dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
    font-size: var(--fs-sitni);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-plava);
  }
  .detalji__lista dd {
    margin: 0;
    font-size: 1.0625rem;
  }
  .pitanja-mreza {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 60em) {
    .pitanja-mreza {
      grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
      gap: 5rem;
      align-items: start;
    }
  }
</style>
