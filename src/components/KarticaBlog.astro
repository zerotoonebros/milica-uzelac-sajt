---
import type { CollectionEntry } from 'astro:content';
import Fotografija from './Fotografija.astro';
import { datum, vremeCitanja } from '../lib/sajt';

interface Props {
  tekst: CollectionEntry<'blog'>;
  /** Redni broj — određuje izgled ilustracije dok nema fotografije */
  indeks?: number;
  nivoNaslova?: 'h2' | 'h3';
}
const { tekst, indeks = 0, nivoNaslova: Naslov = 'h3' } = Astro.props;
const sabloni = [2, 4, 3] as const;
---

<article class="blog-kartica">
  <Fotografija
    slika={tekst.data.slika}
    alt={tekst.data.slika_alt ?? ''}
    odnos="3/2"
    sablon={sabloni[indeks % 3]}
    napomena={false}
    sizes="(min-width: 64em) 30vw, (min-width: 44em) 46vw, 92vw"
    class="blog-kartica__slika"
  />
  <div class="blog-kartica__telo">
    <p class="blog-kartica__meta">
      <span class="oznaka">{tekst.data.kategorija}</span>
    </p>
    <Naslov class="blog-kartica__naslov">
      <a href={`/blog/${tekst.id}/`}>{tekst.data.naslov}</a>
    </Naslov>
    <p class="blog-kartica__opis">{tekst.data.opis}</p>
    <p class="blog-kartica__dno">
      <time datetime={tekst.data.datum.toISOString().slice(0, 10)}>{datum(tekst.data.datum)}</time>
      <span aria-hidden="true">·</span>
      <span>{vremeCitanja(tekst.body ?? '')} min čitanja</span>
    </p>
  </div>
</article>

<style>
  .blog-kartica {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.25rem;
  }
  .blog-kartica :global(.blog-kartica__slika) {
    transition: transform var(--t-srednje) var(--ease);
  }
  .blog-kartica :global(.blog-kartica__slika img),
  .blog-kartica :global(.blog-kartica__slika svg) {
    transition: transform 700ms var(--ease);
  }
  .blog-kartica:hover :global(.blog-kartica__slika img),
  .blog-kartica:hover :global(.blog-kartica__slika svg) {
    transform: scale(1.04);
  }
  .blog-kartica__telo {
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  .blog-kartica__naslov {
    font-family: var(--font-naslov);
    font-size: clamp(1.45rem, 1.3rem + 0.6vw, 1.75rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .blog-kartica__naslov a {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size var(--t-srednje) var(--ease);
  }
  .blog-kartica__naslov a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .blog-kartica:hover .blog-kartica__naslov a {
    background-size: 100% 1px;
  }
  .blog-kartica__opis {
    color: var(--c-teget-blagi);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .blog-kartica__dno {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--fs-mali);
    color: var(--c-teget-blagi);
  }
</style>
