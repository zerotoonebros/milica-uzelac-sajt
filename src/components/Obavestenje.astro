---
// Obaveštenje (diskretni baner) odmah ispod zaglavlja: nova radionica, novi program, novost na sajtu.
// Uključuje se i isključuje u CMS-u: Podešavanja → Obaveštenje na vrhu sajta.
// Prikazuje se samo kada je uključeno i ima tekst. Posle datuma „Prikazuj do“ nestaje samo.
// Posetiteljka može da ga zatvori; izbor se pamti dok se tekst obaveštenja ne promeni.
import Ikona from './Ikona.astro';
import { obavestenje, jeSpoljni } from '../lib/sajt';

const tekst = obavestenje.tekst?.trim() ?? '';
const oznaka = obavestenje.oznaka?.trim() ?? '';
const link = obavestenje.link?.trim() ?? '';
const tekstLinka = obavestenje.tekst_linka?.trim() || 'Saznaj više';
const doDatuma = /^\d{4}-\d{2}-\d{2}/.test(obavestenje.prikazuj_do ?? '') ? obavestenje.prikazuj_do.slice(0, 10) : '';

const bezKoseCrte = (p: string) => p.replace(/\/+$/, '');
const danas = new Date().toISOString().slice(0, 10);
const prikazi =
  Boolean(obavestenje.prikazi) &&
  tekst !== '' &&
  (!doDatuma || doDatuma >= danas) &&
  // Na stranici na koju obaveštenje vodi nema potrebe da se prikazuje
  !(link && bezKoseCrte(Astro.url.pathname) === bezKoseCrte(link));

// Potpis obaveštenja: kada se tekst ili link promene, zatvoreno obaveštenje se ponovo prikazuje.
let zbir = 5381;
for (const znak of `${oznaka}|${tekst}|${link}|${doDatuma}`) zbir = ((zbir * 33) ^ znak.codePointAt(0)!) >>> 0;
const potpis = zbir.toString(36);
---

{
  prikazi && (
    <>
    <aside class="obavestenje" aria-label="Obaveštenje" data-potpis={potpis} data-do={doDatuma || undefined}>
      <div class="omot obavestenje__unutra">
        <p class="obavestenje__tekst">
          {oznaka && <span class="obavestenje__oznaka">{oznaka}</span>}
          <span>{tekst}</span>
          {link && (
            <a
              href={link}
              class="obavestenje__link"
              target={jeSpoljni(link) ? '_blank' : undefined}
              rel={jeSpoljni(link) ? 'noopener' : undefined}
              data-prati="announcement_click"
              data-mesto="baner"
            >
              {tekstLinka}
              <Ikona naziv="strelica" velicina={16} />
            </a>
          )}
        </p>
        <button type="button" class="obavestenje__zatvori" data-obavestenje-zatvori>
          <Ikona naziv="zatvori" velicina={18} />
          <span class="sr-only">Zatvori obaveštenje</span>
        </button>
      </div>
    </aside>
    <script is:inline>
      // Izvršava se odmah posle banera, pre prvog iscrtavanja — bez „skakanja“ stranice.
      (function () {
        var baner = document.currentScript && document.currentScript.previousElementSibling;
        if (!baner) return;
        var KLJUC = 'mu-obavestenje';
        var d = new Date();
        var dve = function (n) {
          return (n < 10 ? '0' : '') + n;
        };
        var danas = d.getFullYear() + '-' + dve(d.getMonth() + 1) + '-' + dve(d.getDate());
        var isteklo = !!baner.dataset.do && baner.dataset.do < danas;
        var zatvoreno = false;
        try {
          zatvoreno = localStorage.getItem(KLJUC) === baner.dataset.potpis;
        } catch (e) {}
        if (isteklo || zatvoreno) {
          baner.hidden = true;
          return;
        }
        var dugme = baner.querySelector('[data-obavestenje-zatvori]');
        if (!dugme) return;
        dugme.addEventListener('click', function () {
          baner.hidden = true;
          try {
            localStorage.setItem(KLJUC, baner.dataset.potpis);
          } catch (e) {}
        });
      })();
    </script>
    </>
  )
}

<style>
  .obavestenje {
    background: var(--c-plava);
    color: var(--c-papir);
    font-size: var(--fs-mali);
    line-height: 1.45;
  }
  .obavestenje__unutra {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding-block: 0.5rem;
  }
  .obavestenje__tekst {
    flex: 1;
    min-width: 0;
  }
  .obavestenje__oznaka {
    display: inline-block;
    margin-right: 0.6rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--z-pilula);
    background: var(--c-kajsija);
    color: var(--c-teget);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.3;
    text-transform: uppercase;
    vertical-align: 0.1em;
  }
  .obavestenje__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-left: 0.5rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration-line: underline;
    text-decoration-color: rgb(255 251 247 / 0.5);
    transition: text-decoration-color var(--t-brzo);
  }
  .obavestenje__link:hover {
    text-decoration-color: currentColor;
  }
  .obavestenje__link :global(svg) {
    flex: none;
    transition: transform var(--t-srednje) var(--ease);
  }
  .obavestenje__link:hover :global(svg) {
    transform: translateX(3px);
  }
  .obavestenje__zatvori {
    /* Bez JavaScript-a dugme ne bi radilo, pa se tada i ne prikazuje */
    display: none;
    position: relative;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    transition: background-color var(--t-brzo);
  }
  :global(.js) .obavestenje__zatvori {
    display: inline-grid;
  }
  /* Veća površina za dodir prstom */
  .obavestenje__zatvori::before {
    content: '';
    position: absolute;
    inset: -0.375rem;
  }
  .obavestenje__zatvori:hover {
    background: rgb(255 251 247 / 0.16);
  }
  .obavestenje :focus-visible {
    outline-color: var(--c-kajsija);
  }

  @media (min-width: 48em) {
    .obavestenje__tekst {
      /* Tekst je na sredini; levo se ostavlja isto mesta koliko desno zauzima dugme za zatvaranje */
      padding-left: 2.75rem;
      text-align: center;
      text-wrap: balance;
    }
  }
</style>
